{
  "name": "aisub_v5",
  "description": "RL combat sub : MLP 256,256 + LSTM 256 x2 couches (deeper memory).",

  "model": {
    "net_arch": [256, 256],
    "lstm_hidden_size": 256,
    "n_lstm_layers": 2
  },

  "training": {
    "total_steps": 2000000,
    "n_envs": 8,
    "max_steps_per_episode": 6000,
    "learning_rate": 1e-5,
    "n_steps": 2048,
    "batch_size": 256,
    "n_epochs": 10,
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "ent_coef": 0.02,
    "ent_coef_end": 0.005,
    "clip_range": 0.2,
    "vf_coef": 0.5,
    "max_grad_norm": 0.5
  },

  "env": {
    "map_name": "combats",
    "spawn_min_m": 1000.0,
    "spawn_max_m": 2000.0
  },

  "reward": {
    "kill_bonus": 100.0,
    "death_penalty": -100.0,
    "damage_dealt_per_hp": 0.2,
    "damage_taken_per_hp": 0.05,
    "time_penalty_per_tick": 0.001,
    "no_los_penalty_per_tick": 0.0005,
    "torpedo_fire_cost": 1.0,
    "lure_drop_cost": 1.0,
    "evade_bonus": 5.0
  }
}
