{
  "name": "Autosub (BT sous-marin)",
  "description": "FSM par blackboard. EVADE_TORP > EVADE_PINGED > EVADE_SURPRISE > RETREAT > ATTACK > APPROACH > STALK > SEARCH. Awareness ennemi influence la profondeur.",
  "tree": {
    "type": "Sequence",
    "name": "Tick complet",
    "children": [
      { "type": "Action", "name": "Sync players[]", "fn": "sync_player" },
      { "type": "Action", "name": "Détection passive", "fn": "passive_detection" },
      {
        "type": "Selector",
        "name": "FSM (priorité haut→bas)",
        "children": [
          {
            "type": "Sequence",
            "name": "EVADE_TORP",
            "children": [
              { "type": "Condition", "fn": "torpedo_acquired" },
              { "type": "Condition", "fn": "is_submarine" },
              { "type": "Action", "fn": "evade_torpedo", "params": { "flee_distance_m": 800.0, "flee_duration_s": 30.0, "noise_margin": 0.05 } }
            ]
          },
          {
            "type": "Sequence",
            "name": "EVADE_PINGED",
            "children": [
              { "type": "Condition", "fn": "was_pinged_recently", "params": { "max_age_s": 5.0 } },
              { "type": "Condition", "fn": "is_submarine" },
              { "type": "Action", "fn": "evade_pinged", "params": { "flee_distance_m": 600.0, "duration_s": 20.0, "noise_margin": 0.05 } }
            ]
          },
          {
            "type": "Sequence",
            "name": "RETREAT",
            "children": [
              { "type": "Condition", "fn": "state_is", "params": { "name": "RETREAT" } },
              { "type": "Condition", "fn": "is_submarine" },
              { "type": "AlwaysSuccess",
                "child": { "type": "Action", "fn": "submerge_periscope", "params": { "hold_s": 60.0 } } },
              { "type": "Action", "fn": "retreat_to_cover", "params": { "arrive_radius_m": 50.0, "timeout_s": 120.0, "noise_margin": 0.05 } }
            ]
          },
          {
            "type": "Sequence",
            "name": "ATTACK",
            "children": [
              { "type": "Condition", "fn": "state_is", "params": { "name": "ATTACK" } },
              { "type": "Condition", "fn": "is_submarine" },
              { "type": "Condition", "fn": "bots_active" },
              { "type": "AlwaysSuccess",
                "child": { "type": "Action", "fn": "submerge_periscope", "params": { "hold_s": 60.0 } } },
              { "type": "Action", "fn": "attack_torpedo_at_known", "params": { "clear_after_s": 30.0, "salvo_size": 1, "max_torpedoes": 4, "relocate_m": 250.0, "cooldown_s": 8.0, "min_dist_destroyer_m": 1500.0, "noise_margin": 0.05, "retreat_after_attack_proba": 0.5 } }
            ]
          },
          {
            "type": "Sequence",
            "name": "APPROACH",
            "children": [
              { "type": "Condition", "fn": "state_is", "params": { "name": "APPROACH" } },
              { "type": "Condition", "fn": "is_submarine" },
              { "type": "AlwaysSuccess",
                "child": { "type": "Action", "fn": "submerge_periscope", "params": { "hold_s": 60.0 } } },
              { "type": "Action", "fn": "approach_enemy", "params": { "attack_range_m": 3000.0, "clear_after_s": 30.0, "noise_margin": 0.05 } }
            ]
          },
          {
            "type": "Sequence",
            "name": "STALK",
            "children": [
              { "type": "Condition", "fn": "state_is", "params": { "name": "STALK" } },
              { "type": "Condition", "fn": "is_submarine" },
              { "type": "AlwaysSuccess",
                "child": { "type": "Action", "fn": "submerge_periscope", "params": { "hold_s": 60.0 } } },
              { "type": "Action", "fn": "wait_observe", "params": { "secs": 15.0, "attack_range_m": 3000.0, "clear_after_s": 30.0, "set_state_after": "SEARCH" } }
            ]
          },
          {
            "type": "Sequence",
            "name": "SEARCH",
            "children": [
              { "type": "Condition", "fn": "state_is", "params": { "name": "SEARCH" } },
              { "type": "Condition", "fn": "is_submarine" },
              {
                "type": "AlwaysSuccess",
                "name": "Transition SEARCH→STALK si ennemi détecté",
                "child": {
                  "type": "Sequence",
                  "children": [
                    { "type": "Condition", "fn": "has_audible_enemy" },
                    { "type": "Action", "fn": "set_state", "params": { "name": "STALK" } }
                  ]
                }
              },
              { "type": "AlwaysSuccess",
                "child": { "type": "Action", "fn": "launch_auto_drones", "params": { "n": 2, "interval_s": 8.0 } } },
              { "type": "AlwaysSuccess",
                "child": { "type": "Action", "fn": "submerge_periscope", "params": { "hold_s": 60.0 } } },
              { "type": "Action", "fn": "navigate_island_hop", "params": { "noise_margin": 0.05 } }
            ]
          },
          {
            "type": "Action",
            "name": "Default → SEARCH",
            "fn": "set_state",
            "params": { "name": "SEARCH" }
          }
        ]
      },
      {
        "type": "AlwaysSuccess",
        "name": "DCA optionnelle",
        "child": {
          "type": "Sequence",
          "children": [
            { "type": "Condition", "fn": "bots_active" },
            { "type": "Condition", "fn": "has_aa" },
            { "type": "Condition", "fn": "aa_cooldown_ok" },
            { "type": "Condition", "fn": "has_human_drone_in_range" },
            { "type": "Action",    "fn": "fire_aa_at_human_drone" }
          ]
        }
      }
    ]
  }
}
